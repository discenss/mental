# backend/.env.prod — переменные бэкенда в проде (скопируй в backend/.env.prod).
# DATABASE_URL и CONTENT_DIR задаются через docker-compose (не дублируй здесь).
LLM_PROVIDER=openai
OPENAI_API_KEY=sk-...            # ключ OpenAI (та же, что локально)
# ANTHROPIC_API_KEY=...          # если LLM_PROVIDER=anthropic

# ── Авторизация iOS-приложения Ridge (§3.1) ──────────────────────────────────
# Telegram-бот НЕ затронут: он продолжает ходить в API телом запроса без токена.
# Пока JWT_SECRET пуст, эндпоинты /api/v1/auth/* отвечают 503, а всё остальное
# работает как раньше.
JWT_SECRET=                      # длинная случайная строка (openssl rand -hex 32)
# JWT_TTL_DAYS=90                # срок жизни мобильной сессии

# Apple Sign-In: audience = bundle id приложения (csv для dev/beta/release)
APPLE_BUNDLE_IDS=day.ridge.app,day.ridge.app.dev,day.ridge.app.beta

# Google Sign-In: OAuth client id из Google Cloud Console (csv; iOS + при желании web)
GOOGLE_CLIENT_IDS=               # ...apps.googleusercontent.com

# Сервисный токен для внутренних вызовов (/reminders/due, /reminders/mark).
# ПУСТО = прежнее поведение, бот работает без токена. Заполнять только вместе
# с настройкой бота, иначе его планировщик получит 401.
INTERNAL_API_TOKEN=

# ── APNs (пуши для iOS) ──────────────────────────────────────────────────────
# Пока ключа нет, отправка — no-op с причиной в ответе, API не падает.
APNS_KEY_PATH=                   # путь к .p8 внутри контейнера (монтировать секретом)
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_TOPIC=day.ridge.app         # = bundle id
APNS_USE_SANDBOX=true            # false для App Store сборки
