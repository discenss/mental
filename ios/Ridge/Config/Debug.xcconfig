#include "Shared.xcconfig"

PRODUCT_BUNDLE_IDENTIFIER = day.ridge.app.dev
PRODUCT_NAME = Ridge Dev

SWIFT_ACTIVE_COMPILATION_CONDITIONS = DEBUG
